# Keep generated launchers portable while storing normalized text in Git.
**/gradlew text eol=lf
**/gradlew.bat text eol=crlf
# Preserve reviewed notice bytes and their recorded/APK hashes, including their
# final separator lines. All other whitespace checks remain enabled.
qualification/probes/device-baseline/app/src/main/assets/third_party_notices/upstream/androidx-LICENSE.txt whitespace=-blank-at-eof
qualification/probes/device-baseline/app/src/main/assets/third_party_notices/runtime-copyrights.txt whitespace=-blank-at-eof
# Exact upstream SSH notice copies retain CRLF/separator/trailing bytes.
qualification/probes/device-baseline/app/src/main/assets/third_party_notices/ssh/slf4j-embedded-LICENSE.txt -text whitespace=cr-at-eol,-blank-at-eof
qualification/probes/device-baseline/app/src/main/assets/third_party_notices/ssh/slf4j-module-LICENSE.txt -text whitespace=-blank-at-eof
qualification/probes/device-baseline/app/src/main/assets/third_party_notices/ssh/sshj-NOTICE.txt -text whitespace=-blank-at-eol
# Preserve the native diagnostic's reviewed notice bytes and APK provenance.
qualification/probes/native-rdp/app/src/main/assets/runtime-copyrights.txt whitespace=-blank-at-eof
qualification/probes/native-usb/app/src/main/assets/runtime-copyrights.txt whitespace=-blank-at-eof
# Unified diffs prefix context with a space before upstream tab indentation.
# Added source indentation remains reviewed through the applied native source.
qualification/probes/native-rdp/patches/*.patch whitespace=-space-before-tab

# This reviewed unified diff retains blank context lines as a single space.
# Its added source lines were checked separately for trailing whitespace.
qualification/probes/native-rdp/patches/android-relative-input.patch whitespace=-space-before-tab,-blank-at-eol
qualification/probes/native-rdp/patches/android-pointer-position.patch whitespace=-space-before-tab,-blank-at-eol

# This exact VNC diff preserves upstream blank/tab/trailing context bytes.
# Its added source lines are reviewed independently and have no trailing spaces.
qualification/probes/native-vnc/adapter/security-and-cancel.patch whitespace=-space-before-tab,-blank-at-eol

# Exact pairing diff retains upstream context whitespace and its final separator.
# Added source lines are separately checked for trailing whitespace.
qualification/probes/native-stream/pairing/finite-pairing.patch whitespace=-space-before-tab,-blank-at-eol,-blank-at-eof
