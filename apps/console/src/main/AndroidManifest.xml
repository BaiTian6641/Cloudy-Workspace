<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Explicit SSH operations own their sockets; no background service or exported credentials. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <permission android:name="io.github.baitian6641.cloudy.console.permission.FILES_HANDOFF"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.baitian6641.cloudy.desktop.permission.FILES_HANDOFF" />
    <queries><package android:name="io.github.baitian6641.cloudy.desktop" /></queries>
    <application android:allowBackup="false" android:supportsRtl="true"
        android:usesCleartextTraffic="false" android:label="@string/app_name"
        android:theme="@style/Theme.CloudyWindow"
        android:icon="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/cloudy_data_extraction_rules">
        <!-- Always owns a document task even when an external caller omits launch flags.
             Incoming Intent extras/data are never restored as application state. -->
        <activity android:name=".WorkspaceActivity" android:exported="true"
            android:launchMode="standard" android:documentLaunchMode="always"
            android:resizeableActivity="true" android:windowSoftInputMode="adjustResize">
            <property android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudyVaultActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudyProfilesActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudySshTrustActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudyDisplaySettingsActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudySshObserveActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudySshAuthenticateActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudySshFilesActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudyTerminalActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudySshConfigImportActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudyFilesLocationsActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="io.github.baitian6641.cloudy.platform.CloudySharedLocationsActivity"
            android:exported="false" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- Bound only: each receiver enforces its own permission and actual caller per transaction. -->
        <service android:name="io.github.baitian6641.cloudy.platform.CloudyFilesHandoffService"
            android:exported="true"
            android:permission="io.github.baitian6641.cloudy.console.permission.FILES_HANDOFF" />
    </application>
</manifest>
