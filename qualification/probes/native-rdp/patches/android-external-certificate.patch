+/* External certificate management delegates the full PEM chain to the Java
+ * owner before any CA/known-host acceptance path. Never return a negative
+ * status: the upstream TLS error branch logs certificate bytes for negatives. */
+static int android_verify_x509_certificate(freerdp* instance, const BYTE* data, size_t length,
+                                           const char* hostname, UINT16 port, DWORD flags)
+{
+	if (!instance || !data || length == 0 || length > 128 * 1024 || !hostname)
+		return 0;
+
+	JNIEnv* env = nullptr;
+	jboolean attached = jni_attach_thread(&env);
+	if (!env)
+	{
+		if (attached == JNI_TRUE)
+			jni_detach_thread();
+		return 0;
+	}
+
+	int accepted = 0;
+	BOOL frame = FALSE;
+	if ((*env)->ExceptionCheck(env))
+		goto out;
+	if ((*env)->PushLocalFrame(env, 8) < 0)
+		goto out;
+	frame = TRUE;
+
+	jbyteArray pem = (*env)->NewByteArray(env, (jsize)length);
+	if (!pem || (*env)->ExceptionCheck(env))
+		goto out;
+	(*env)->SetByteArrayRegion(env, pem, 0, (jsize)length, (const jbyte*)data);
+	if ((*env)->ExceptionCheck(env))
+		goto out;
+	jstring host = (*env)->NewStringUTF(env, hostname);
+	if (!host || (*env)->ExceptionCheck(env))
+		goto out;
+
+	const jint result = freerdp_callback_int_result(
+	    "OnVerifyX509Certificate", "(J[BLjava/lang/String;JJ)I", (jlong)instance, pem,
+	    host, (jlong)port, (jlong)flags);
+	if (!(*env)->ExceptionCheck(env) && result == 1)
+		accepted = 1;
+out:
+	/* Allocation, missing-method and Java validation exceptions all reject.
+	 * Do not describe exceptions: their messages may contain certificate data. */
+	if ((*env)->ExceptionCheck(env))
+		(*env)->ExceptionClear(env);
+	if (frame)
+		(*env)->PopLocalFrame(env, nullptr);
+	if (attached == JNI_TRUE)
+		jni_detach_thread();
+	return accepted;
 }

