+/* Owner invokes after argument parsing and before the one connect attempt.
+ * External mode bypasses CA/known-host fallback; callers must not configure
+ * CertificateAcceptedFingerprints, which is a prior positive shortcut. */
+JNIEXPORT jboolean JNICALL
+Java_com_freerdp_freerdpcore_services_LibFreeRDP_freerdp_1set_1external_1certificate_1management(
+    JNIEnv* env, jclass cls, jlong instance)
+{
+	WINPR_UNUSED(env);
+	WINPR_UNUSED(cls);
+	freerdp* inst = (freerdp*)instance;
+	if (!inst || !inst->context || !inst->context->settings)
+		return JNI_FALSE;
+	androidContext* ctx = (androidContext*)inst->context;
+	if (ctx->threadStarted || ctx->thread)
+		return JNI_FALSE;
+	if (!freerdp_settings_set_bool(inst->context->settings, FreeRDP_ExternalCertificateManagement,
+	                               TRUE))
+		return JNI_FALSE;
+	inst->VerifyX509Certificate = android_verify_x509_certificate;
+	return JNI_TRUE;
+}
