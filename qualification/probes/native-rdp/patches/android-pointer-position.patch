 static BOOL android_Pointer_SetPosition(rdpContext* context, UINT32 x, UINT32 y)
 {
-	WINPR_ASSERT(context);
-
-	return TRUE;
+	/* These are authoritative server coordinates, not input or local prediction.
+	 * Reject narrowing instead of wrapping UINT32 into negative JNI coordinates. */
+	if (!context || !context->instance || x > INT32_MAX || y > INT32_MAX)
+	{
+		WLog_ERR(TAG, "Pointer position callback has invalid context or JNI coordinate range");
+		return FALSE;
+	}
+
+	JNIEnv* env = nullptr;
+	jboolean attached = jni_attach_thread(&env);
+	BOOL delivered = FALSE;
+	if (env && !(*env)->ExceptionCheck(env) && gJavaActivityClass && gOnPointerSetPositionMethod)
+	{
+		(*env)->CallStaticVoidMethod(env, gJavaActivityClass, gOnPointerSetPositionMethod,
+		                             (jlong)context->instance, (jint)x, (jint)y);
+		delivered = !(*env)->ExceptionCheck(env);
+	}
+	/* The authored Java wrapper retains Sink failures synchronously. JNI lookup,
+	 * attachment or unexpected Java failures must still fail the native update;
+	 * never leave a pending exception or log its potentially private message. */
+	if (env && (*env)->ExceptionCheck(env))
+		(*env)->ExceptionClear(env);
+	if (attached == JNI_TRUE)
+		jni_detach_thread();
+	if (!delivered)
+		WLog_ERR(TAG, "Pointer position callback delivery failed");
+	return delivered;
 }
 
