+/* Only the connected callback publishes this negotiated snapshot. Reading
+ * settings directly from a Java producer would race the native handshake. */
+BOOL android_relative_input_supported(freerdp* inst)
+{
+	if (!inst || !inst->context)
+		return FALSE;
+	androidContext* ctx = (androidContext*)inst->context;
+	return InterlockedCompareExchange(&ctx->relativeInputEnabled, 0, 0) == 1;
+}
+
+ANDROID_EVENT_RELATIVE_CURSOR* android_event_relative_cursor_new(int flags, int dx, int dy)
+{
+	const int buttons = PTR_FLAGS_BUTTON1 | PTR_FLAGS_BUTTON2 | PTR_FLAGS_BUTTON3;
+	const int allowed = PTR_FLAGS_MOVE | PTR_FLAGS_DOWN | buttons;
+	/* Wheels use their existing route; reject unknown bits and DOWN without
+	 * buttons instead of truncating flags/deltas at the JNI boundary. */
+	if (dx < INT16_MIN || dx > INT16_MAX || dy < INT16_MIN || dy > INT16_MAX ||
+	    flags < 0 || (flags & ~allowed) || !(flags & (PTR_FLAGS_MOVE | buttons)) ||
+	    ((flags & PTR_FLAGS_DOWN) && !(flags & buttons)))
+		return nullptr;
+	ANDROID_EVENT_RELATIVE_CURSOR* event = calloc(1, sizeof(*event));
+	if (!event)
+		return nullptr;
+	event->type = EVENT_TYPE_RELATIVE_CURSOR;
+	event->flags = (UINT16)flags;
+	event->dx = (INT16)dx;
+	event->dy = (INT16)dy;
+	return event;
+}
+
+BOOL android_send_relative_event(freerdp* inst, int flags, int dx, int dy)
+{
+	if (!android_relative_input_supported(inst))
+		return FALSE;
+	ANDROID_EVENT* event = (ANDROID_EVENT*)android_event_relative_cursor_new(flags, dx, dy);
+	if (!event)
+		return FALSE;
+	if (!android_push_event(inst, event))
+	{
+		android_event_free(event);
+		return FALSE;
+	}
+	/* Queue acceptance only; the native consumer/core can still reject delivery. */
+	return TRUE;
 }
 
