<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="false" android:usesCleartextTraffic="false"
        android:label="@string/app_name" android:theme="@style/AppTheme"
        android:icon="@drawable/ic_probe" android:dataExtractionRules="@xml/backup_rules">
        <activity android:name="dev.cloudy.qualification.x11broker.BrokerActivity"
            android:exported="true" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="dev.cloudy.qualification.x11broker.XWindowActivity"
            android:exported="false" android:launchMode="standard"
            android:documentLaunchMode="always" android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <property android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
        </activity>
    </application>
</manifest>
